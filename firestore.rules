rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chi cho phep dung cac tai khoan cua gia dinh (vo & chong) truy cap, khong phan biet chu hoa/thuong
    function isFamilyMember() {
      return request.auth != null && 
        request.auth.token.email.matches('(?i)^(lhoaiphuoc@gmail\\.com|phuocbaulam@gmail\\.com|que7tam@gmail\\.com|dieuhong1013@gmail\\.com|dieuhong1013@gmail\\.co)$');
    }

    match /family/{document=**} {
      allow read, write: if isFamilyMember();
    }
    
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId && isFamilyMember();
    }
  }
}
